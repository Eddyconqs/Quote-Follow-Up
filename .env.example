# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quotefollowup?schema=public"

# Auth
AUTH_SECRET="replace-with-a-long-random-string-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email provider (Resend). Leave EMAIL_PROVIDER_API_KEY empty to use the mock provider.
# Get a key at https://resend.com/api-keys. Until a sending domain is verified there,
# EMAIL_FROM_ADDRESS must stay "onboarding@resend.dev", and Resend will only actually
# deliver to the email address that owns the Resend account.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# SMS provider (leave empty to use the mock provider)
SMS_PROVIDER_API_KEY=""
SMS_FROM_NUMBER=""

# AI provider (leave empty to use the mock provider)
AI_PROVIDER_API_KEY=""

# Shared secret required on the /api/cron/process-follow-ups scheduler endpoint.
# Vercel automatically sends it as `Authorization: Bearer $CRON_SECRET` for the
# schedule defined in vercel.json. Leave empty for local development; set it
# before deploying so the endpoint can't be triggered by anyone who can reach it.
CRON_SECRET=""
